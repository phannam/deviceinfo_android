<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Device tab (spec 003): network type, and IMEI/SIM/serial on Android 8-9. Asked on tap. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Device tab: Google Services Framework ID. -->
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />

    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.gsf" />
        <package android:name="com.google.android.modulemetadata" />
    </queries>

    <application
        android:name=".DeviceInfoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceInfo">
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".feature.screentest.ScreenTestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DeviceInfo.ScreenTest" />
        <activity
            android:name=".feature.config.ConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
