<?xml version="1.0" encoding="utf-8"?>
<!-- Swatch tint, check tint, selection scale, and content description are set in SwatchAdapter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/swatchItemSize"
    android:layout_height="@dimen/swatchItemSize"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/swatch"
        android:layout_width="@dimen/swatchSize"
        android:layout_height="@dimen/swatchSize"
        android:layout_gravity="center"
        android:background="@drawable/bg_swatch"
        tools:backgroundTint="@color/brand_primary" />

    <ImageView
        android:id="@+id/check"
        android:layout_width="@dimen/configIconSize"
        android:layout_height="@dimen/configIconSize"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check" />
</FrameLayout>
