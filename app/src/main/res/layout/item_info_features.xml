<?xml version="1.0" encoding="utf-8"?>
<!-- Feature checklist as chips; background follows RowPosition. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/mediumGap"
    android:paddingTop="@dimen/tinyGap"
    android:paddingBottom="@dimen/smallGap"
    tools:background="@drawable/bg_row_bottom">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/feature_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</FrameLayout>
