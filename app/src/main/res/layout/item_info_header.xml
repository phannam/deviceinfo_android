<?xml version="1.0" encoding="utf-8"?>
<!-- Section title at the top of a card; background follows RowPosition. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/mediumGap"
    android:paddingTop="@dimen/mediumGap"
    android:paddingBottom="@dimen/tinyGap"
    tools:background="@drawable/bg_row_top">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="@dimen/sectionIconSize"
        android:layout_height="@dimen/sectionIconSize"
        android:layout_marginEnd="@dimen/smallGap"
        android:importantForAccessibility="no"
        app:tint="?attr/colorPrimaryOnBackground"
        tools:src="@drawable/ic_phone_android" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimaryOnBackground"
        tools:text="Device" />
</LinearLayout>
