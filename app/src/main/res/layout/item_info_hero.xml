<?xml version="1.0" encoding="utf-8"?>
<!-- Summary card at the top of a tab, such as the device name or the Android version. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hero"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/mediumGap">

    <LinearLayout
        android:layout_width="@dimen/heroBadgeSize"
        android:layout_height="@dimen/heroBadgeSize"
        android:background="@drawable/bg_hero_badge"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/badge_icon"
            android:layout_width="@dimen/heroBadgeIconSize"
            android:layout_height="@dimen/heroBadgeIconSize"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="?attr/colorOnPrimary"
            tools:src="@drawable/ic_smartphone" />

        <TextView
            android:id="@+id/badge_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnPrimary"
            tools:text="34" />

        <TextView
            android:id="@+id/badge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnPrimary"
            tools:text="API" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mediumGap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnPrimaryContainer"
            tools:text="Android 14" />

        <TextView
            android:id="@+id/hero_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnPrimaryContainer"
            tools:text="Upside Down Cake" />

        <TextView
            android:id="@+id/hero_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tinyGap"
            android:alpha="0.8"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnPrimaryContainer"
            tools:text="Released Oct 4, 2023" />
    </LinearLayout>
</LinearLayout>
