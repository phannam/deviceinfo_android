<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flat rounded card on the gray screen background (spec 002 section 4.1). -->
    <style name="Widget.DeviceInfo.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/cardCornerRadius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.DeviceInfo.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicatorColor">?attr/colorSecondary</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabSelectedTextColor">?attr/colorPrimaryOnBackground</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabRippleColor">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Widget.DeviceInfo.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?android:attr/colorBackground</item>
    </style>

    <!-- Text and outlined buttons use the readable primary tone instead of colorPrimary. -->
    <style name="Widget.DeviceInfo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/button_text_readable</item>
        <item name="iconTint">@color/button_text_readable</item>
    </style>

    <style name="Widget.DeviceInfo.Button.TextButton.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/button_text_readable</item>
        <item name="iconTint">@color/button_text_readable</item>
    </style>

    <style
        name="Widget.DeviceInfo.Button.TextButton.Dialog.Flush"
        parent="Widget.Material3.Button.TextButton.Dialog.Flush">
        <item name="android:textColor">@color/button_text_readable</item>
        <item name="iconTint">@color/button_text_readable</item>
    </style>

    <style name="ShapeAppearance.DeviceInfo.AppIcon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">25%</item>
    </style>

    <!-- One of the three equal tiles on the config page. -->
    <style name="Widget.DeviceInfo.ConfigTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">@dimen/mediumGap</item>
    </style>

    <style name="Widget.DeviceInfo.ConfigTileLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/smallGap</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.DeviceInfo.FooterLink" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">@dimen/tinyGap</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorSecondaryOnBackground</item>
    </style>

    <!-- Value column of a left-right info row (spec 003 section 4.1). -->
    <style name="TextAppearance.DeviceInfo.RowValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
